# QueBook Environment Variables
# Copy this file to .env (or backend/.env) and fill in your actual credentials
# Never commit .env to version control

# ── Database Connection ────────────────────────────────────────
# Neon Cloud PostgreSQL (recommended):
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.c-3.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local PostgreSQL (alternative):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/quebook

# ── Server Options ─────────────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
